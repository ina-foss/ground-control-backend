meta {
  name: Add plugin autocomplete TV Channel
  type: http
  seq: 3
}

post {
  url: {{GC_BACKEND_BASE_URL}}/plugin/
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "name": "name_test",
      "type": "autocomplete",
      "data_categories": "data_categories test",
      "display_zone": "bloc",
      "step_id": 1,
      "config_data": {
        "type": "plugin_autocomplete",
        "data_source": "https://player-expert.d.sas.ina/assets/listOfChannel/tvChannels.json",
        "data_type": "json",
        "search_attr": "title",
        "response_id_key": "$[*].id",
        "response_ext_id_key": "$[*].code",
        "response_label_key": "$[*].label"
      }
    }
}
